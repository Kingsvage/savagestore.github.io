rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onlyProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'uid', 'name', 'email', 'photo', 'phone', 'freeFireUid', 'codMobileUid',
        'country', 'preferredGame', 'createdAt', 'updatedAt'
      ]);
    }

    function validGameId(data) {
      return !('gameId' in data) || data.gameId in ['free-fire', 'call-of-duty'];
    }

    function validOrderStatus(status) {
      return status in ['processing', 'delivered', 'failed'];
    }

    function validListingStatus(status) {
      return status in ['pending-review', 'approved', 'rejected', 'sold', 'removed', 'under-sale', 'suspended'];
    }

    function isValidTopupOrder(orderId) {
      return request.resource.data.keys().hasOnly([
          'orderId', 'orderType', 'gameId', 'userId', 'customerName', 'customerEmail',
          'googleEmail', 'gameUID', 'supplierOfferId', 'item', 'price',
          'paymentStatus', 'fulfillmentStatus', 'status', 'createdAt'
        ]) &&
        request.resource.data.orderType == 'topup' &&
        request.resource.data.orderId == orderId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'processing' &&
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.fulfillmentStatus == 'pending' &&
        request.resource.data.supplierOfferId is string &&
        request.resource.data.gameUID is string &&
        request.resource.data.customerEmail is string &&
        request.resource.data.googleEmail is string &&
        request.resource.data.item is string &&
        request.resource.data.price is number &&
        request.resource.data.price > 0 &&
        validGameId(request.resource.data) &&
        !('listingId' in request.resource.data);
    }

    function sellerCancelPendingListing() {
      return signedIn() &&
        resource.data.sellerId == request.auth.uid &&
        resource.data.status == 'pending-review' &&
        request.resource.data.status == 'removed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'removedAt', 'removedBy', 'updatedAt'
        ]);
    }

    function adminListingUpdate() {
      return isAdmin() &&
        validListingStatus(request.resource.data.status) &&
        request.resource.data.sellerId == resource.data.sellerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy',
          'removedAt', 'removedBy', 'reviewedAt', 'reviewedBy', 'adminReason',
          'updatedAt', 'soldAt', 'soldTo', 'saleId'
        ]);
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if settingId == 'public';
      allow create, update: if settingId == 'public' && isAdmin() &&
        request.resource.data.keys().hasOnly([
          'topupEnabled', 'marketplaceEnabled', 'maintenanceMode', 'supportWhatsapp',
          'branding', 'updatedAt', 'updatedBy'
        ]) &&
        request.resource.data.topupEnabled is bool &&
        request.resource.data.marketplaceEnabled is bool &&
        request.resource.data.maintenanceMode is bool &&
        request.resource.data.supportWhatsapp is string;
      allow delete: if false;
    }

    // Finance settings are accessible to Cloud Functions only.
    match /privateSettings/{settingId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow create: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.get('email', '') == request.auth.token.email &&
        request.resource.data.get('name', '') == request.auth.token.name &&
        request.resource.data.get('photo', '') == request.auth.token.picture &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'photo', 'phone', 'freeFireUid', 'codMobileUid',
          'country', 'preferredGame', 'createdAt', 'updatedAt'
        ]);
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.get('email', '') == request.auth.token.email &&
        request.resource.data.get('name', '') == request.auth.token.name &&
        request.resource.data.get('photo', '') == request.auth.token.picture &&
        onlyProfileFields();
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if signedIn() && isValidTopupOrder(orderId);
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() &&
        validOrderStatus(request.resource.data.status) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.get('orderType', 'legacy') == resource.data.get('orderType', 'legacy') &&
        request.resource.data.get('price', 0) == resource.data.get('price', 0) &&
        request.resource.data.get('paymentStatus', 'pending') == resource.data.get('paymentStatus', 'pending') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'adminNotes', 'updatedAt', 'deliveredAt', 'failedAt',
          'statusUpdatedBy', 'deliveryReceiptSent', 'deliveryReceiptSentAt'
        ]) &&
        (request.resource.data.status != 'delivered' ||
          resource.data.get('orderType', 'legacy') != 'topup' || resource.data.get('paymentStatus', 'pending') == 'paid');
      allow delete: if false;
    }

    match /listings/{listingId} {
      allow create: if false; // New listings are validated and written by submitAccountListing.
      allow read: if isAdmin() ||
        (signedIn() && resource.data.sellerId == request.auth.uid) ||
        resource.data.status == 'approved';
      allow update: if adminListingUpdate() || sellerCancelPendingListing();
      allow delete: if false;
    }

    match /listingSecrets/{listingId} {
      allow read: if signedIn() && resource.data.sellerId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /accountSwaps/{swapId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create, update, delete: if false; // Callable functions enforce game policy and review authorization.
    }

    match /accountSwapSecrets/{swapId} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // Admin SDK only.
    }

    match /accountSales/{saleId} {
      allow read: if isAdmin() ||
        (signedIn() && (resource.data.sellerId == request.auth.uid || resource.data.buyerId == request.auth.uid));
      allow create, update, delete: if false; // Fee and payout values are backend-authoritative.
    }

    match /profileLookupTokens/{tokenId} {
      allow read, write: if false;
    }

    match /profileLookupRateLimits/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

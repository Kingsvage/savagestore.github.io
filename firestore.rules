rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function onlyProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'uid', 'name', 'email', 'photo', 'phone', 'freeFireUid', 'codMobileUid',
        'country', 'preferredGame', 'updatedAt'
      ]);
    }

    match /admins/{adminId} { allow read: if isOwner(adminId) || isAdmin(); allow write: if false; }
    match /settings/{settingId} {
      allow read: if settingId == 'config';
      allow write: if settingId == 'config' && isAdmin();
    }
    match /users/{userId} {
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) && request.resource.data.uid == request.auth.uid && onlyProfileFields();
      allow delete: if false;
    }
    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.paymentStatus == 'pending' && request.resource.data.fulfillmentStatus == 'pending' &&
        request.resource.data.status == 'processing' && request.resource.data.price is number && request.resource.data.price > 0;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      // Cloud Functions use the Admin SDK and bypass these rules. Customers cannot alter payment or fulfillment state.
      allow update, delete: if isAdmin();
    }
    match /listings/{listingId} {
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid && request.resource.data.status == 'pending-review' && request.resource.data.price is number && request.resource.data.price > 0;
      allow get: if isAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid) || resource.data.status == 'approved';
      allow list: if isAdmin() || (signedIn() && resource.data.status == 'approved');
      allow update, delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
